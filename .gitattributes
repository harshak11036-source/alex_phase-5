# Auto detect text files and perform LF normalization
* text=auto

# Ensure scripts use LF
*.sh text eol=lf
*.ps1 text eol=crlf

# Ensure config files use LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.config text eol=lf

# Source code - use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.go text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Prisma
*.prisma text eol=lf

# Docker
Dockerfile* text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# Binary files - no normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.sqlite binary
*.db binary