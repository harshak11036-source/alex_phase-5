{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@alex/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@alex/shared-types/*": ["../../packages/shared-types/src/*"],
      "@alex/shared-utils": ["../../packages/shared-utils/src/index.ts"],
      "@alex/shared-utils/*": ["../../packages/shared-utils/src/*"],
      "@alex/validation-schemas": ["../../packages/validation-schemas/src/index.ts"],
      "@alex/validation-schemas/*": ["../../packages/validation-schemas/src/*"],
      "@prisma/client": ["../../node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/.prisma/client"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "prisma/seed.sqlite.ts"]
}