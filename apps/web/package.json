{
  "name": "apps/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/infrastructure.test.cjs && node --test tests/routes-and-integration.test.cjs && node --test tests/ai-service.test.cjs && node --test tests/document-pipeline.test.cjs && node --test tests/research-notebook.test.cjs && node --test tests/teacher-classroom.test.cjs",
    "test:watch": "node --test --watch tests/*.test.cjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.cjs",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:push:postgres": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node ../../scripts/reset-dev-db.js",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
