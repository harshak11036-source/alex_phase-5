  status             String              @default("COMPLETED")
  verificationStatus String              @default("UNVERIFIED")
  verifiedBy         String?
  verifiedAt         DateTime?
  certificateUrl     String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([verificationStatus])
  @@map("student_achievements")
}

model GuardianContact {
  id            String    @id @default(cuid())
  institutionId String
  studentId     String
  name          String
  relationship  String
  email         String?
  phone         String?
  whatsapp      String?
  isPrimary     Boolean   @default(false)
  consentGiven  Boolean   @default(false)
  consentAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     User        @relation("GuardianStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([institutionId, studentId, email])
  @@unique([institutionId, studentId, phone])
  @@index([studentId])
  @@map("guardian_contacts")
}

model AuditLog {
