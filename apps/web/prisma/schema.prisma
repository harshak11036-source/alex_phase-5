generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  LECTURER
  PROJECT_MENTOR
  ADMIN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  EXTRACTING
  CHUNKING
  EMBEDDING
  INDEXING
  READY
  FAILED
}

enum DocumentType {
  PDF
  DOC
  DOCX
  TXT
  MARKDOWN
  CSV
  XLS
  XLSX
  PPT
  PPTX
  PNG
  JPG
  JPEG
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  ON_DUTY
}

enum AssessmentType {
  INTERNAL_ASSESSMENT
  ASSIGNMENT
  QUIZ
  LAB_ASSESSMENT
  PROJECT
  PRESENTATION
  PRACTICAL_EXAM
  SEMESTER_EXAM
  OTHER
}

enum AssignmentStatus {
  DRAFT
  SUBMITTED
  LATE
  RESUBMITTED
  EVALUATED
  PUBLISHED
}

enum AchievementCategory {
  INTERNSHIP
  CERTIFICATION
  WORKSHOP
  HACKATHON
  RESEARCH_PUBLICATION
  TECHNICAL_COMPETITION
  CLUB_ACTIVITY
  VOLUNTEERING
  PROJECT
  AWARD
  PLACEMENT_PREPARATION
  OTHER
}

enum NotificationCategory {
  ASSIGNMENT
  ATTENDANCE
  INTERNAL_ASSESSMENT
  ACADEMIC_ANNOUNCEMENT
  PROJECT_MILESTONE
  MENTOR_FEEDBACK
  RESEARCH_UPDATE
  STUDY_REMINDER
  UPCOMING_DEADLINE
  DOCUMENT_PROCESSING_FAILURE
  AI_TASK_COMPLETION
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectRole {
  OWNER
  MEMBER
  MENTOR
}

enum MemoryCategory {
  CONVERSATION_HISTORY
  EXPLICIT_MEMORIES
  ACADEMIC_CONTEXT
  PROJECT_CONTEXT
  RETRIEVED_KNOWLEDGE
}

enum AIProviderType {
  NVIDIA_NEMOTRON
  OPENAI
  GOOGLE_GEMINI
  ANTHROPIC
  MISTRAL
  GROQ
  OPENROUTER
  TOGETHER_AI
  OTHER
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  domain    String?  @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments         Department[]
  courses             Course[]
  academicYears       AcademicYear[]
  semesters           Semester[]
  users               CollegeMembership[]
  subjects            Subject[]
  guardianContacts    GuardianContact[]
  notificationConfigs NotificationConfig[]
  auditLogs           AuditLog[]

  @@map("institutions")
}

model Department {
  id            String   @id @default(cuid())
  name          String
  code          String
  institutionId String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courses     Course[]
  subjects    Subject[]
  users       CollegeMembership[]

  @@unique([institutionId, code])
  @@map("departments")
}

model Course {
  id            String   @id @default(cuid())
  name          String
  code          String
  institutionId String
  departmentId  String
  durationYears Int
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesters   Semester[]
  users       CollegeMembership[]

  @@unique([institutionId, code])
  @@map("courses")
}

model AcademicYear {
  id            String   @id @default(cuid())
  name          String
  institutionId String
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semesters   Semester[]
  memberships CollegeMembership[]

  @@unique([institutionId, name])
  @@map("academic_years")
}

model Semester {
  id             String   @id @default(cuid())
  name           String
  number         Int
  institutionId  String
  academicYearId String
  courseId       String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjects           Subject[]
  enrollments        SubjectEnrollment[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  memberships        CollegeMembership[]

  @@unique([institutionId, academicYearId, courseId, number])
  @@map("semesters")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  firstName     String
  lastName      String
  avatarUrl     String?
  role          UserRole  @default(STUDENT)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships         CollegeMembership[]
  documents           Document[]               @relation("DocumentOwner")
  processedDocs       Document[]               @relation("DocumentProcessor")
  conversations       Conversation[]
  messages            Message[]                @relation("MessageSender")
  memories            UserMemory[]
  tasks               Task[]                   @relation("TaskAssignee")
  createdTasks        Task[]                   @relation("TaskCreator")
  plannerEvents       PlannerEvent[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  aiCredentials       AICredential[]
  researchNotebooks   ResearchNotebook[]       @relation("NotebookOwner")
  researchNotes       ResearchNote[]
  projects            ProjectMember[]
  projectTasks        ProjectTask[]            @relation("ProjectTaskAssignee")
  attendanceRecords   AttendanceRecord[]
  assessments         AssessmentResult[]
  assignments         AssignmentSubmission[]
  achievements        StudentAchievement[]
  guardianContacts    GuardianContact[]        @relation("GuardianStudent")
  auditLogs           AuditLog[]               @relation("AuditLogUser")
  subjectResources    SubjectResource[]        @relation("ResourceUploader")
  assignedSubjects    LecturerAssignment[]
  projectMentorships  ProjectMentor[]          @relation("ProjectMentorships")
  studyMaterials      StudyMaterial[]
  flashcardDecks      FlashcardDeck[]
  mindMaps            MindMap[]
  diagrams            Diagram[]
  quizzes             Quiz[]
  generatedImages     GeneratedImage[]
  subjectEnrollments  SubjectEnrollment[]      @relation("SubjectEnrollmentUser")
  projectOwned        Project[]                @relation("ProjectOwner")
  projectTasksCreated ProjectTask[]            @relation("ProjectTaskCreator")
  projectDiscussions  ProjectDiscussion[]      @relation("ProjectDiscussionUser")
  dropboxConnection   DropboxConnection?

  @@map("users")
}

model DropboxConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  accountEmail String?
  accountName  String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  rootPath     String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dropbox_connections")
}

model CollegeMembership {
  id             String           @id @default(cuid())
  userId         String
  institutionId  String
  departmentId   String?
  courseId       String?
  semesterId     String?
  academicYearId String?
  role           UserRole
  status         MembershipStatus @default(PENDING)
  studentId      String?          @unique
  employeeId     String?          @unique
  enrolledAt     DateTime         @default(now())
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semester     Semester?     @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@unique([userId, institutionId])
  @@map("college_memberships")
}

model Subject {
  id            String   @id @default(cuid())
  name          String
  code          String
  institutionId String
  departmentId  String
  semesterId    String
  credits       Int      @default(3)
  description   String?
  syllabus      String?
  textbooks     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution        Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department         Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semester           Semester             @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  enrollments        SubjectEnrollment[]
  lecturers          LecturerAssignment[]
  resources          SubjectResource[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  assignments        Assignment[]
  documents          Document[]           @relation("SubjectDocuments")
  plannerEvents      PlannerEvent[]
  studyMaterials     StudyMaterial[]
  flashcardDecks     FlashcardDeck[]
  mindMaps           MindMap[]
  diagrams           Diagram[]
  quizzes            Quiz[]
  generatedImages    GeneratedImage[]

  @@unique([institutionId, semesterId, code])
  @@map("subjects")
}

model SubjectEnrollment {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String
  semesterId String
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)

  user     User     @relation("SubjectEnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("subject_enrollments")
}

model LecturerAssignment {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String
  assignedAt DateTime @default(now())
  assignedBy String?
  isPrimary  Boolean  @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("lecturer_assignments")
}

model Document {
  id            String         @id @default(cuid())
  title         String
  description   String?
  fileName      String
  fileSize      BigInt
  mimeType      String
  documentType  DocumentType
  storagePath   String
  storageBucket String         @default("documents")
  checksum      String
  status        DocumentStatus @default(UPLOADED)
  errorMessage  String?
  pageCount     Int?
  metadata      Json?
  ownerId       String
  subjectId     String?
  projectId     String?
  notebookId    String?
  processorId   String?
  processedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner           User                    @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  processor       User?                   @relation("DocumentProcessor", fields: [processorId], references: [id], onDelete: SetNull)
  subject         Subject?                @relation("SubjectDocuments", fields: [subjectId], references: [id], onDelete: SetNull)
  project         Project?                @relation("ProjectDocuments", fields: [projectId], references: [id], onDelete: SetNull)
  notebook        ResearchNotebook?       @relation("NotebookDocuments", fields: [notebookId], references: [id], onDelete: SetNull)
  chunks          DocumentChunk[]
  processingJobs  DocumentProcessingJob[]
  versions        DocumentVersion[]
  studyMaterials  StudyMaterial[]         @relation("StudyMaterialSourceDoc")
  flashcardDecks  FlashcardDeck[]         @relation("FlashcardDeckSourceDoc")
  mindMaps        MindMap[]               @relation("MindMapSourceDoc")
  diagrams        Diagram[]               @relation("DiagramSourceDoc")
  quizzes         Quiz[]                  @relation("QuizSourceDoc")
  generatedImages GeneratedImage[]        @relation("GeneratedImageSourceDoc")
  researchSources ResearchSource[]

  @@index([ownerId])
  @@index([subjectId])
  @@index([projectId])
  @@index([notebookId])
  @@index([status])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  fileName    String
  fileSize    BigInt
  storagePath String
  checksum    String
  createdBy   String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

model DocumentChunk {
  id           String   @id @default(cuid())
  documentId   String
  content      String   @db.Text
  chunkIndex   Int
  pageNumber   Int?
  sectionTitle String?
  tokenCount   Int
  embedding    Bytes?
  metadata     Json?
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
  @@map("document_chunks")
}

model DocumentProcessingJob {
  id           String         @id @default(cuid())
  documentId   String
  step         String
  status       DocumentStatus
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
  @@map("document_processing_jobs")
}

model Conversation {
  id         String   @id @default(cuid())
  title      String?
  userId     String
  projectId  String?
  notebookId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notebook ResearchNotebook? @relation("NotebookConversations", fields: [notebookId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@index([projectId])
  @@index([notebookId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  role           String
  content        String   @db.Text
  metadata       Json?
  toolCalls      Json?
  toolResults    Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model UserMemory {
  id         String         @id @default(cuid())
  userId     String
  category   MemoryCategory
  key        String
  value      String         @db.Text
  confidence Float          @default(1.0)
  source     String?
  isVerified Boolean        @default(false)
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key])
  @@index([userId, category])
  @@map("user_memories")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  assigneeId  String
  creatorId   String
  dueDate     DateTime?
  completedAt DateTime?
  isCompleted Boolean   @default(false)
  priority    Int       @default(0)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignee      User           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  plannerEvents PlannerEvent[]

  @@index([assigneeId])
  @@index([dueDate])
  @@index([isCompleted])
  @@map("tasks")
}

model PlannerEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  allDay      Boolean  @default(false)
  eventType   String
  subjectId   String?
  taskId      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startTime])
  @@index([eventType])
  @@map("planner_events")
}

model Notification {
  id            String               @id @default(cuid())
  userId        String
  category      NotificationCategory
  title         String
  message       String
  referenceId   String?
  referenceType String?
  isRead        Boolean              @default(false)
  readAt        DateTime?
  metadata      Json?
  createdAt     DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id           String               @id @default(cuid())
  userId       String
  category     NotificationCategory
  inAppEnabled Boolean              @default(true)
  emailEnabled Boolean              @default(false)
  pushEnabled  Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

model NotificationConfig {
  id             String   @id @default(cuid())
  institutionId  String
  provider       String
  providerConfig Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, provider])
  @@map("notification_configs")
}

model NotificationDelivery {
  id               String    @id @default(cuid())
  notificationId   String
  provider         String
  recipient        String
  status           String
  providerResponse Json?
  sentAt           DateTime?
  deliveredAt      DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())

  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

model AICredential {
  id           String         @id @default(cuid())
  userId       String
  provider     AIProviderType
  providerName String
  encryptedKey String
  keyHash      String
  isActive     Boolean        @default(true)
  isDefault    Boolean        @default(false)
  models       Json?
  usageLimit   Int?
  usageCount   Int            @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@map("ai_credentials")
}

model AIModelConfig {
  id         String         @id @default(cuid())
  userId     String
  provider   AIProviderType
  modelId    String
  taskType   String
  isDefault  Boolean        @default(false)
  parameters Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, provider, modelId, taskType])
  @@index([userId, taskType])
  @@map("ai_model_configs")
}

model ResearchNotebook {
  id          String   @id @default(cuid())
  title       String
  description String?
  ownerId     String
  projectId   String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User             @relation("NotebookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project       Project?         @relation("ProjectResearchNotebooks", fields: [projectId], references: [id], onDelete: SetNull)
  sources       ResearchSource[]
  notes         ResearchNote[]
  conversations Conversation[]   @relation("NotebookConversations")
  documents     Document[]       @relation("NotebookDocuments")

  @@index([ownerId])
  @@index([projectId])
  @@map("research_notebooks")
}

model ResearchSource {
  id              String   @id @default(cuid())
  notebookId      String
  documentId      String?
  title           String
  authors         Json?
  publicationYear Int?
  doi             String?
  url             String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notebook ResearchNotebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  document Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([notebookId])
  @@map("research_sources")
}

model ResearchNote {
  id         String   @id @default(cuid())
  notebookId String
  userId     String
  title      String
  content    String   @db.Text
  sourceIds  String[]
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notebook ResearchNotebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notebookId])
  @@index([userId])
  @@map("research_notes")
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  category    String?
  tags        String[]
  ownerId     String
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner             User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members           ProjectMember[]
  mentors           ProjectMentor[]
  tasks             ProjectTask[]
  milestones        ProjectMilestone[]
  discussions       ProjectDiscussion[]
  documents         Document[]          @relation("ProjectDocuments")
  conversations     Conversation[]
  researchNotebooks ResearchNotebook[]  @relation("ProjectResearchNotebooks")

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  invitedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectMentor {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMentorships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_mentors")
}

model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  assigneeId  String?
  creatorId   String
  status      String    @default("TODO")
  priority    Int       @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User    @relation("ProjectTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@map("project_tasks")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime
  completedAt DateTime?
  isCompleted Boolean   @default(false)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dueDate])
  @@map("project_milestones")
}

model ProjectDiscussion {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  title     String
  content   String   @db.Text
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User                @relation("ProjectDiscussionUser", fields: [userId], references: [id], onDelete: Cascade)
  parent  ProjectDiscussion?  @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies ProjectDiscussion[] @relation("DiscussionReplies")

  @@index([projectId])
  @@index([parentId])
  @@map("project_discussions")
}

model AttendanceSession {
  id          String   @id @default(cuid())
  subjectId   String
  semesterId  String
  date        DateTime
  period      Int
  topic       String?
  conductedBy String
  isCancelled Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject  Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  records  AttendanceRecord[]

  @@unique([subjectId, date, period])
  @@index([semesterId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  userId    String
  status    AttendanceStatus
  markedBy  String
  markedAt  DateTime         @default(now())
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("attendance_records")
}

model Assessment {
  id             String         @id @default(cuid())
  subjectId      String
  semesterId     String
  name           String
  type           AssessmentType
  maxMarks       Int
  weight         Float          @default(1.0)
  assessmentDate DateTime
  description    String?
  isPublished    Boolean        @default(false)
  publishedAt    DateTime?
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subject  Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  results  AssessmentResult[]

  @@index([subjectId])
  @@index([semesterId])
  @@map("assessments")
}

model AssessmentResult {
  id            String    @id @default(cuid())
  assessmentId  String
  userId        String
  marksObtained Float
  feedback      String?
  gradedBy      String?
  gradedAt      DateTime?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
  @@index([userId])
  @@map("assessment_results")
}

model Assignment {
  id                String   @id @default(cuid())
  subjectId         String
  title             String
  description       String?
  instructions      String?
  maxMarks          Int
  weight            Float    @default(1.0)
  assignedDate      DateTime
  dueDate           DateTime
  allowedFormats    String[]
  allowResubmission Boolean  @default(false)
  maxSubmissions    Int      @default(1)
  isPublished       Boolean  @default(false)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
  attachments AssignmentAttachment[]

  @@index([subjectId])
  @@index([dueDate])
  @@map("assignments")
}

model AssignmentAttachment {
  id           String   @id @default(cuid())
  assignmentId String
  fileName     String
  storagePath  String
  fileSize     BigInt
  mimeType     String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("assignment_attachments")
}

model AssignmentSubmission {
  id               String           @id @default(cuid())
  assignmentId     String
  userId           String
  status           AssignmentStatus @default(DRAFT)
  submissionNumber Int              @default(1)
  content          String?
  submittedAt      DateTime?
  gradedAt         DateTime?
  marksObtained    Float?
  feedback         String?
  gradedBy         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assignment  Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments SubmissionAttachment[]

  @@unique([assignmentId, userId, submissionNumber])
  @@index([userId])
  @@index([status])
  @@map("assignment_submissions")
}

model SubmissionAttachment {
  id           String   @id @default(cuid())
  submissionId String
  fileName     String
  storagePath  String
  fileSize     BigInt
  mimeType     String
  createdAt    DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_attachments")
}

model StudentAchievement {
  id                 String              @id @default(cuid())
  userId             String
  title              String
  category           AchievementCategory
  organization       String?
  startDate          DateTime?
  endDate            DateTime?
