# ALEX Deployment Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit this file with real secrets!

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.web.app
NEXTAUTH_URL=https://your-domain.web.app
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# =============================================================================
# DATABASE (Prisma + PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/alex?schema=public
# For connection pooling (recommended for serverless)
# DATABASE_URL=postgresql://user:password@host:5432/alex?schema=public&pgbouncer=true

# =============================================================================
# FIREBASE (Client-side config - safe to expose)
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# =============================================================================
# FIREBASE ADMIN (Server-side only - NEVER expose to client)
# =============================================================================
# Option 1: Service Account JSON (for Firebase Functions)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option 2: Individual fields (for other environments)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =============================================================================
# AI PROVIDERS (Server-side only - NEVER expose to client)
# =============================================================================
# NVIDIA Nemotron (Primary)
NVIDIA_NEMOTRON_API_KEY=nvapi-your-key
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra
NVIDIA_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI
OPENAI_API_KEY=sk-your-key

# Google Gemini
GOOGLE_GEMINI_API_KEY=your-gemini-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key

# Other providers (configure as needed)
MISTRAL_API_KEY=your-mistral-key
GROQ_API_KEY=gsk_your-key
OPENROUTER_API_KEY=sk-or-your-key
TOGETHER_AI_API_KEY=your-together-key

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_MODE=firebase
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_RESOURCES=resources
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,csv,xls,xlsx,ppt,pptx,png,jpg,jpeg

# =============================================================================
# EMAIL (Configure your provider)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@your-domain.com

# =============================================================================
# ENCRYPTION
# =============================================================================
ENCRYPTION_KEY=your-32-character-encryption-key

# =============================================================================
# BACKGROUND JOBS (Optional)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# OCR (Optional)
# =============================================================================
TESSERACT_PATH=/usr/bin/tesseract

# =============================================================================
# MONITORING (Optional)
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn
LOG_LEVEL=info